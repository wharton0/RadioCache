<?xml version="1.0" encoding="utf-8"?>
<!--
  Waveform bars. The tallest bar is solid white; the others step down in
  alpha, which builds hierarchy without a second colour. Pill shapes come
  from round-capped strokes rather than path arcs.
  Geometry is centred on (54,54) and stays inside the 66dp adaptive-icon
  safe zone (checked against the circular mask).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Bar 1 — shortest, faintest -->
    <path
        android:pathData="M34.5,51 L34.5,57"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="8"
        android:strokeAlpha="0.55"
        android:strokeLineCap="round" />

    <!-- Bar 2 — medium -->
    <path
        android:pathData="M47.5,44 L47.5,64"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="8"
        android:strokeAlpha="0.55"
        android:strokeLineCap="round" />

    <!-- Bar 3 — the peak, solid white (the accent) -->
    <path
        android:pathData="M60.5,36 L60.5,72"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="8"
        android:strokeLineCap="round" />

    <!-- Bar 4 — medium-short -->
    <path
        android:pathData="M73.5,48 L73.5,60"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="8"
        android:strokeAlpha="0.55"
        android:strokeLineCap="round" />
</vector>